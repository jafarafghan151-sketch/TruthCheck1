import express from "express";

const app = express();
app.use(express.json());
app.use(express.static("public"));

// 🔴 Demo-KI (keine echte API nötig für Start)
function fakeCheck(url) {
  const r = Math.random();

  if (r < 0.33) {
    return {
      label: "🟢 Vertrauenswürdig",
      reason: "Quelle wirkt stabil und bekannt."
    };
  } else if (r < 0.66) {
    return {
      label: "🟡 Unklar",
      reason: "Zu wenige Informationen zur Quelle."
    };
  } else {
    return {
      label: "🔴 Wahrscheinlich Fake News",
      reason: "Quelle wirkt nicht vertrauenswürdig."
    };
  }
}

app.post("/api/check", (req, res) => {
  const { url } = req.body;

  const result = fakeCheck(url);

  res.json(result);
});

app.listen(3000, () => {
  console.log("TruthCheck läuft auf http://localhost:3000");
});
{
  "name": "truthcheck",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "express": "^4.18.2"
  },
  "scripts": {
    "start": "node server.js"
  }
}<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>TruthCheck</title>
</head>
<body style="font-family:Arial; max-width:500px; margin:50px auto;">

  <h1>🧠 TruthCheck</h1>

  <input id="url" placeholder="Artikel-Link eingeben" style="width:100%; padding:10px;">
  <button onclick="check()" style="margin-top:10px; padding:10px; width:100%;">
    Prüfen
  </button>

  <h3 id="result"></h3>

  <script>
    async function check() {
      const url = document.getElementById("url").value;

      const res = await fetch("/api/check", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url })
      });

      const data = await res.json();

      document.getElementById("result").innerText =
        data.label + " — " + data.reason;
    }
  </script>

</body>
</html>
